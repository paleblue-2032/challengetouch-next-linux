<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ct-next</vendor>

  <!-- Lets the desktop user power the tablet off / reboot it through
       "pkexec /usr/local/bin/ct-next-power [poweroff|reboot]".
       loginctl/elogind cannot be used: the session is started by hand, so
       elogind sees no session and does nothing. -->
  <action id="org.ct.next.power">
    <description>Power off or reboot the tablet</description>
    <message>Power off or reboot the tablet</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/ct-next-power</annotate>
  </action>
</policyconfig>
