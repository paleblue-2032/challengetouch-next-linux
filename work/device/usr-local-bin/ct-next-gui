#!/bin/sh
# Keep the desktop (Xorg + GNOME Flashback session as user alpine) alive on the
# DSI panel. Uses explicit PIDs and a pidfile so only one supervisor runs
# (pgrep does not reliably see "Xorg" on this kernel).
export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
export DISPLAY=:0
LOG=/var/log/ct-next-gui.log
PIDFILE=/run/ct-next-gui.pid
log() { echo "$(date '+%H:%M:%S') $*" >>"$LOG"; }
mkdir -p /tmp/.X11-unix /var/log /run /run/user/1000
chown alpine:alpine /run/user/1000 2>/dev/null
chmod 700 /run/user/1000

if [ -f "$PIDFILE" ]; then
	old=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
		log "supervisor already running ($old)"
		exit 0
	fi
fi
echo $$ >"$PIDFILE"

XPID=""
SPID=""
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }

# GNOME Flashback has no component that draws the root window (nautilus-desktop
# is gone), so without this the desktop stays black. The colour is a solid PNG.
WALL_B64='iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAD0lEQVR42mOwwAEYhpYEAGm4KgEIAvPmAAAAAElFTkSuQmCC'
set_wallpaper() {
	printf '%s' "$WALL_B64" | base64 -d > /tmp/.wall.png 2>/dev/null
	[ -s /tmp/.wall.png ] && feh --bg-fill /tmp/.wall.png >/dev/null 2>&1
}

start_x() {
	rm -f /tmp/.X0-lock
	rm -rf /tmp/.X11-unix
	mkdir -p /tmp/.X11-unix
	Xorg :0 -logfile /var/log/Xorg.0.log >>"$LOG" 2>&1 &
	XPID=$!
	i=0
	while [ ! -S /tmp/.X11-unix/X0 ] && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	log "Xorg up (pid $XPID) after ${i}s"
}

start_session() {
	# GNOME must not run as root; run as alpine via su.
	setsid su alpine -c /usr/local/bin/ct-next-session >>"$LOG" 2>&1 &
	SPID=$!
	# Set the root background once the session is up (it resets it otherwise).
	( sleep 10; set_wallpaper; sleep 15; set_wallpaper ) &
	log "GNOME session started (pid $SPID)"
}

while :; do
	if ! alive "$XPID"; then
		start_x
		alive "$SPID" && kill "$SPID" 2>/dev/null
		SPID=""
	fi
	if alive "$XPID" && ! alive "$SPID"; then
		start_session
	fi
	sleep 5
done
